---
import PrivacyPage from '@/components/pages/PrivacyPage.astro';
import { prefixedLocales } from '@/i18n/utils';

// Solo los idiomas CON prefijo (todos menos el por defecto, que vive en '/privacy/').
export async function getStaticPaths() {
	return prefixedLocales.map((lang) => ({ params: { lang } }));
}

---
import { languages } from '@/i18n/ui';
import { getLangFromUrl, localePath, stripLocale, type SupportedLang } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
// Ruta actual SIN el prefijo de idioma, para conservar la página al cambiar
// (p. ej. /privacy/ -> /es/privacy/, no /es/). '' se normaliza a '/'.
const rest = stripLocale(Astro.url.pathname);
// Solo la home lleva ancla de sección; se resuelve en build, no con regex en cliente.
const isHome = rest === '/';
---

<div class="flex flex-row gap-1">
	{
		Object.entries(languages).map(([langPrefix, label]) => {
			if (langPrefix == lang) return <></>;
			const target = localePath(langPrefix as SupportedLang, rest);
			return (
				<a
					href={target}
					data-lang-link
					data-base={target}
					data-home={isHome ? 'true' : null}
					class="hover:scale-125 transition"
					aria-label={`Cambiar idioma a ${langPrefix}`}
				>
					{label}
				</a>
			);
		})
	}
</div>

<script>
	// Al cambiar de idioma conservamos la página actual (data-base ya la trae) y,
	// SOLO en la home, la sección en la que está el usuario.
	//
	// El cambio lo hace ClientRouter (swap), NO una recarga: antes había un
	// data-astro-reload para delegar el scroll al ancla en el navegador, pero eso
	// forzaba navegación completa de documento y al volver a '/' (destino SIN
	// ancla) asomaba un flash blanco — el fondo oscuro depende de la clase .dark
	// que ThemeScript pone ya dentro del documento nuevo, demasiado tarde. Así
	// que reponemos aquí el scroll que antes hacía el navegador.

	// Ancla destino del cambio de idioma en curso ('' = arriba del todo). Se arma
	// en el click y se consume en el swap siguiente; va fuera de astro:page-load
	// para no re-registrar el listener en cada navegación.
	let pendingHash: string | null = null;

	document.addEventListener('astro:after-swap', () => {
		if (pendingHash === null) return; // navegación ajena (nav, back/forward): la gestiona Astro
		const hash = pendingHash;
		pendingHash = null;

		const anchor = hash ? document.getElementById(hash.slice(1)) : null;
		// after-swap corre antes del paint, pero html lleva scroll-behavior:smooth
		// y animaría el salto: lo desactivamos para que sea instantáneo, igual que
		// el salto nativo a un fragmento.
		const root = document.documentElement;
		const previous = root.style.scrollBehavior;
		root.style.scrollBehavior = 'auto';
		if (anchor) anchor.scrollIntoView({ block: 'start' });
		else window.scrollTo(0, 0);
		root.style.scrollBehavior = previous;
	});

	document.addEventListener('astro:page-load', () => {
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]');
		if (!links.length) return;

		const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));

		const currentSection = () => {
			const probe = window.scrollY + 140; // margen por el header fijo
			let id = '';
			for (const s of sections) {
				if (s.offsetTop <= probe) id = s.id;
			}
			if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4 && sections.length) {
				id = sections[sections.length - 1].id;
			}
			return id;
		};

		const sync = () => {
			const sec = currentSection();
			links.forEach((a) => {
				const base = a.dataset.base ?? '/';
				const isHome = a.dataset.home === 'true'; // solo la home lleva ancla de sección
				a.setAttribute('href', base + (isHome && sec ? `#${sec}` : ''));
			});
		};

		sync();
		window.addEventListener('scroll', sync, { passive: true });
		links.forEach((a) => {
			a.addEventListener('pointerdown', sync);
			// pointerdown ya dejó el href al día, así que aquí leemos el definitivo.
			a.addEventListener('click', () => {
				pendingHash = new URL(a.href, window.location.href).hash;
			});
		});
	});
</script>

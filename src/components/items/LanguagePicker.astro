---
import { languages } from '@/i18n/ui';
import { getLangFromUrl, localePath, stripLocale, type SupportedLang } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
// Ruta actual SIN el prefijo de idioma, para conservar la página al cambiar
// (p. ej. /privacy/ -> /es/privacy/, no /es/). '' se normaliza a '/'.
const rest = stripLocale(Astro.url.pathname);
// Solo la home lleva ancla de sección; se resuelve en build, no con regex en cliente.
const isHome = rest === '/';
---

<div class="flex flex-row gap-1">
	{
		Object.entries(languages).map(([langPrefix, label]) => {
			if (langPrefix == lang) return <></>;
			const target = localePath(langPrefix as SupportedLang, rest);
			return (
				<a
					href={target}
					data-lang-link
					data-base={target}
					data-home={isHome ? 'true' : null}
					data-astro-reload
					class="hover:scale-125 transition"
					aria-label={`Cambiar idioma a ${langPrefix}`}
				>
					{label}
				</a>
			);
		})
	}
</div>

<script>
	// Al cambiar de idioma conservamos la página actual (data-base ya la trae) y,
	// SOLO en la home, la sección en la que está el usuario. Usamos data-astro-reload
	// para que el navegador haga el scroll nativo al ancla de forma fiable.
	document.addEventListener('astro:page-load', () => {
		const links = document.querySelectorAll<HTMLAnchorElement>('[data-lang-link]');
		if (!links.length) return;

		const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));

		const currentSection = () => {
			const probe = window.scrollY + 140; // margen por el header fijo
			let id = '';
			for (const s of sections) {
				if (s.offsetTop <= probe) id = s.id;
			}
			if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 4 && sections.length) {
				id = sections[sections.length - 1].id;
			}
			return id;
		};

		const sync = () => {
			const sec = currentSection();
			links.forEach((a) => {
				const base = a.dataset.base ?? '/';
				const isHome = a.dataset.home === 'true'; // solo la home lleva ancla de sección
				a.setAttribute('href', base + (isHome && sec ? `#${sec}` : ''));
			});
		};

		sync();
		window.addEventListener('scroll', sync, { passive: true });
		links.forEach((a) => a.addEventListener('pointerdown', sync));
	});
</script>

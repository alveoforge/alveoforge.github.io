---
import Layout from '@/layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { SITE_URL } from '@/consts';
import Hero from '@/components/sections/Hero.astro';
import VideoDemo from '@/components/sections/VideoDemo.astro';
import Problem from '@/components/sections/Problem.astro';
import Why from '@/components/sections/Why.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Numbers from '@/components/sections/Numbers.astro';
import UnderTheHood from '@/components/sections/UnderTheHood.astro';
import WhatYouGet from '@/components/sections/WhatYouGet.astro';
import Process from '@/components/sections/Process.astro';
import Roadmap from '@/components/sections/Roadmap.astro';
import Founder from '@/components/sections/Founder.astro';
// import Reviews from '@/components/sections/Reviews.astro'; // mock — reactivar con testimonios reales
import Faq from '@/components/sections/Faq.astro';
import FinalCta from '@/components/sections/FinalCta.astro';

// Cuerpo de la landing, compartido por la home de cada idioma:
//   src/pages/index.astro        → '/'     (en, idioma por defecto)
//   src/pages/[lang]/index.astro → '/es/'  (resto de idiomas)
// El idioma se deduce de la URL, igual que en el resto de secciones.
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const faqGroups = t('faq.groups');
const faqJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqGroups.flatMap((g) =>
		g.items.map((f) => ({
			'@type': 'Question',
			name: f.q,
			acceptedAnswer: { '@type': 'Answer', text: f.a },
		}))
	),
};

const appJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'SoftwareApplication',
	name: 'AlveoForge',
	applicationCategory: 'DeveloperApplication',
	operatingSystem: 'Any',
	url: SITE_URL,
	description: t('layout.appDescription'),
	softwareRequirements: 'Java 25, Spring Boot 4.1',
	author: { '@id': `${SITE_URL}#organization` },
	featureList: [
		'Hexagonal architecture with vertical slicing',
		'95–100% test coverage across unit, integration, component and e2e',
		'Deterministic output: same schema, same code',
		'PostgreSQL, MongoDB, Redis with transactional outbox',
		'Flyway or Liquibase migrations',
		'No vendor lock-in: standard Maven, standard Spring Boot',
	],
	// Señal de precio SIN cifra: precio por proyecto que escala con tamaño y
	// complejidad del schema. Reutiliza la copy bilingüe ya aprobada (cta.pricing).
	// Google marcará "price recommended" (aviso, no error); lo aceptamos a cambio
	// de que buscadores y motores de respuesta entiendan el modelo de precio.
	offers: {
		'@type': 'Offer',
		priceCurrency: 'EUR',
		url: SITE_URL,
		availability: 'https://schema.org/InStock',
		description: t('cta.pricing'),
	},
};
---

<Layout
	title={t('layout.title')}
	description={t('layout.description')}
	keywords={t('layout.keywords')}
	lang={lang}
	ogTitle={t('og.title')}
	ogDescription={t('og.description')}
	faqJsonLd={faqJsonLd}
	appJsonLd={appJsonLd}
>
	<main>
		<Hero />
		<VideoDemo />
		<Problem />
		<Why />
		<HowItWorks />
		<Numbers />
		<UnderTheHood />
		<WhatYouGet />
			<Process />
		<Roadmap />
		<Founder />
		{/* <Reviews /> — mock; reactivar con testimonios reales */}
		<Faq />
		<FinalCta />
	</main>
</Layout>

---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
const t = useTranslations(getLangFromUrl(Astro.url));
const groups = t('faq.groups');
---

<section id="faq" class="max-w-3xl mx-auto px-4 py-20 md:py-28">
	<SectionHeading eyebrow={t('faq.eyebrow')} title={t('faq.title')} />
	<div class="mt-10 space-y-10">
		{groups.map((g) => (
			<div>
				<h3 class="font-mono text-xs uppercase tracking-[0.14em] text-ink-faint mb-3">{g.label}</h3>
				<div class="space-y-3">
					{g.items.map((f) => (
						<details class="af-card group">
							<summary class="flex items-center justify-between gap-4 cursor-pointer list-none [&::-webkit-details-marker]:hidden p-5 font-semibold">
								{f.q}
								<span class="flex-none text-2xl leading-none text-ember dark:text-ember-hot transition-transform group-open:rotate-45">+</span>
							</summary>
							<p class="px-5 pb-5 text-sm af-muted">{f.a}</p>
						</details>
					))}
				</div>
			</div>
		))}
	</div>
</section>

---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
import { CONTACT_EMAIL, ONEPAGER_URL, YOUTUBE_URL } from '@/consts';
const currentYear = new Date().getFullYear();
---

<footer class="w-full max-w-4xl mx-auto px-4 py-10 mt-4">
	<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
		<div class="flex items-center gap-2.5">
			<svg viewBox="0 0 60 69" class="w-5 h-6" aria-hidden="true">
				<path d="M30 3 L57 18.5 L57 50.5 L30 66 L3 50.5 L3 18.5 Z" fill="none" class="stroke-ember dark:stroke-ember-hot" stroke-width="5" stroke-linejoin="round" />
				<path d="M15 22 L45 22 L47 26 L47 30 L36 30 L36 40 L39 40 L39 42.5 L44 42.5 L44 48 L16 48 L16 42.5 L21 42.5 L21 40 L24 40 L24 30 L13 30 L13 26 Z" class="fill-steel dark:fill-steel-light" />
			</svg>
			<span class="text-sm text-ink-soft dark:text-[#9aa5b4]">© {currentYear} {t('footer.rights')}</span>
		</div>
		<div class="flex flex-wrap items-center gap-x-5 gap-y-2">
			<a href={ONEPAGER_URL} target="_blank" rel="noopener" class="text-sm font-medium text-ink-soft dark:text-[#9aa5b4] hover:text-ember dark:hover:text-ember-hot transition">{t('footer.onepager')}</a>
			<a href={`/${lang}/privacy`} class="text-sm font-medium text-ink-soft dark:text-[#9aa5b4] hover:text-ember dark:hover:text-ember-hot transition">{t('footer.privacyLink')}</a>
			<a href={YOUTUBE_URL} target="_blank" rel="noopener" class="text-sm font-medium text-ink-soft dark:text-[#9aa5b4] hover:text-ember dark:hover:text-ember-hot transition">{t('footer.youtube')}</a>
			<a href={`mailto:${CONTACT_EMAIL}`} class="text-sm font-medium text-ember dark:text-ember-hot hover:underline">{CONTACT_EMAIL}</a>
		</div>
	</div>
	<p class="mt-4 text-xs text-ink-faint max-w-2xl">{t('footer.privacy')}</p>
</footer>

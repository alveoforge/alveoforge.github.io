---
import { getLangFromUrl, localePath, useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const items = t('why.items');
---

<section id="why" class="max-w-4xl mx-auto px-4 py-20 md:py-28">
	<SectionHeading eyebrow={t('why.eyebrow')} title={t('why.title')} />
	<div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4">
		{items.map((it) => (
			<div class="af-card p-5">
				<h3 class="font-semibold">{it.t}</h3>
				<p class="mt-2 text-sm af-muted">{it.d}</p>
			</div>
		))}
	</div>
	<p class="mt-8">
		<a href={localePath(lang, '/hexagonal-vs-layered/')} class="text-sm font-semibold text-ember dark:text-ember-hot hover:underline">{lang === 'es' ? 'Hexagonal vs en capas, a fondo →' : 'Hexagonal vs layered, in depth →'}</a>
	</p>
</section>

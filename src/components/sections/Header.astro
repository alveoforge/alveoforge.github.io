---
import ThemeToggle from '@/components/items/ThemeToggle.astro';
import { getLangFromUrl, localePath, useTranslations } from '../../i18n/utils';
import LanguagePicker from '@/components/items/LanguagePicker.astro';
import { CAL_URL } from '@/consts';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Home del idioma actual: '/' (en) o '/es/'.
const base = localePath(lang, '/');

// Estructura del nav (como las empresas): un desplegable "Product" con las
// secciones de contenido, luego destinos de primer nivel, luego las páginas.
//   Home · Product ▾ · Roadmap · Autor · FAQ | Blog · Demos | Book a call · tema · idioma
const productLinks = [
	{ title: t('video.eyebrow'), label: 'video', url: `${base}#video` },
	{ title: t('problem.eyebrow'), label: 'problem', url: `${base}#problem` },
	{ title: t('nav.why'), label: 'why', url: `${base}#why` },
	{ title: t('nav.how'), label: 'how', url: `${base}#how` },
	{ title: t('nav.numbers'), label: 'numbers', url: `${base}#numbers` },
	{ title: t('nav.hood'), label: 'hood', url: `${base}#hood` },
	{ title: t('nav.get'), label: 'get', url: `${base}#get` },
];
const topLinks = [
	{ title: t('nav.roadmap'), label: 'roadmap', url: `${base}#roadmap` },
	{ title: t('nav.about'), label: 'about', url: `${base}#about` },
	{ title: t('nav.faq'), label: 'faq', url: `${base}#faq` },
];
const pageLinks = [
	{ title: t('nav.demos'), label: 'demos', url: localePath(lang, '/demos/') },
	{ title: t('nav.blog'), label: 'blog', url: localePath(lang, '/blog/') },
];

// Marcado de "página actual" para los enlaces que son PÁGINAS aparte (Demos,
// Blog): el scroll-spy se basa en las <section> de la home y no puede detectarlos.
// Activo si la ruta actual está dentro del enlace (incluye subrutas como
// /blog/<slug>/). Normalizamos la barra final para comparar de forma estable.
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const isPageActive = (url: string) => withSlash(Astro.url.pathname).startsWith(withSlash(url));

const linkClass =
	'relative hidden lg:block px-3 py-1.5 rounded-full transition hover:text-ember dark:hover:text-ember-hot';

// Panel de menú flotante: fondo OPACO + sombra. (No usar `af-card`: es
// semitransparente y el contenido del hero se colaría por detrás → ilegible.)
const menuPanel =
	'rounded-xl border border-black/[0.07] dark:border-white/10 shadow-lg bg-white dark:bg-[#141a22]';
---

<header class="fixed top-0 z-20 flex flex-col items-center w-full mx-auto mt-3 px-3">
	<nav
		id="header-nav"
		class="flex items-center gap-1 px-2 py-1.5 text-sm font-medium rounded-full
		border border-black/5 dark:border-white/10 bg-white/70 dark:bg-[#141a22]/70 backdrop-blur-md
		shadow-sm text-ink-soft dark:text-[#9aa5b4]"
	>
		<a
			href={`${base}#home`}
			aria-label="home"
			class="flex items-center gap-1.5 pl-1.5 pr-2 transition hover:text-ember dark:hover:text-ember-hot"
			title="AlveoForge"
		>
			<svg viewBox="0 0 60 69" class="w-5 h-6" aria-hidden="true">
				<path d="M30 3 L57 18.5 L57 50.5 L30 66 L3 50.5 L3 18.5 Z" fill="none" class="stroke-ember dark:stroke-ember-hot" stroke-width="5" stroke-linejoin="round" />
				<path d="M15 22 L45 22 L47 26 L47 30 L36 30 L36 40 L39 40 L39 42.5 L44 42.5 L44 48 L16 48 L16 42.5 L21 42.5 L21 40 L24 40 L24 30 L13 30 L13 26 Z" class="fill-steel dark:fill-steel-light" />
			</svg>
			<span class="hidden sm:inline">{t('nav.home')}</span>
		</a>

		<!-- Desplegable Product (desktop) -->
		<div class="relative hidden lg:block">
			<button
				id="product-btn"
				type="button"
				aria-haspopup="true"
				aria-expanded="false"
				class="inline-flex items-center gap-1 px-3 py-1.5 rounded-full transition hover:text-ember dark:hover:text-ember-hot"
			>
				{t('footer.colProduct')}
				<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<polyline points="6 9 12 15 18 9" />
				</svg>
			</button>
			<div id="product-menu" class={`hidden flex-col absolute left-0 top-full mt-2 w-56 p-2 ${menuPanel}`}>
				{productLinks.map((link) => (
					<a
						class="block px-3 py-2 rounded-lg transition hover:bg-ember/10 hover:text-ember dark:hover:text-ember-hot"
						aria-label={link.label}
						href={link.url}
					>
						{link.title}
					</a>
				))}
			</div>
		</div>

		<!-- Primer nivel: Roadmap · Autor · FAQ -->
		{topLinks.map((link) => (
			<a class={linkClass} aria-label={link.label} href={link.url}>
				{link.title}
			</a>
		))}

		<span class="hidden lg:block w-px h-4 mx-1 bg-black/10 dark:bg-white/15" aria-hidden="true" />

		<!-- Páginas: Blog · Demos -->
		{pageLinks.map((link) => (
			<a
				class={`${linkClass}${isPageActive(link.url) ? ' text-ember' : ''}`}
				aria-label={link.label}
				href={link.url}
			>
				{link.title}
			</a>
		))}

		<a
			href={CAL_URL}
			target="_blank"
			rel="noopener"
			class="hidden lg:inline-block ml-1 px-4 py-1.5 rounded-full font-semibold text-white bg-ember hover:brightness-110 transition whitespace-nowrap"
		>
			{t('nav.cta')}
		</a>
		<ThemeToggle />
		<LanguagePicker />

		<!-- Botón de menú (solo móvil) -->
		<button
			id="menu-btn"
			type="button"
			class="lg:hidden ml-1 grid place-items-center size-8 rounded-full hover:text-ember dark:hover:text-ember-hot transition"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
				<line x1="4" y1="7" x2="20" y2="7"></line>
				<line x1="4" y1="12" x2="20" y2="12"></line>
				<line x1="4" y1="17" x2="20" y2="17"></line>
			</svg>
		</button>
	</nav>

	<!-- Menú desplegable (solo móvil) — agrupado: Product, primer nivel, páginas -->
	<div
		id="mobile-menu"
		class={`lg:hidden hidden mt-2 w-[min(92vw,20rem)] max-h-[calc(100dvh-5rem)] overflow-y-auto overscroll-contain p-2 flex-col text-sm font-medium text-ink-soft dark:text-[#9aa5b4] ${menuPanel}`}
	>
		<p class="px-3 pt-1 pb-1 font-mono text-[10px] uppercase tracking-[0.12em] text-ink-faint">{t('footer.colProduct')}</p>
		{productLinks.map((link) => (
			<a class="block px-3 py-2 rounded-lg hover:bg-ember/10 hover:text-ember dark:hover:text-ember-hot transition" href={link.url}>
				{link.title}
			</a>
		))}
		<div class="my-1 border-t border-black/5 dark:border-white/10" aria-hidden="true" />
		{topLinks.map((link) => (
			<a class="block px-3 py-2.5 rounded-lg hover:bg-ember/10 hover:text-ember dark:hover:text-ember-hot transition" href={link.url}>
				{link.title}
			</a>
		))}
		<div class="my-1 border-t border-black/5 dark:border-white/10" aria-hidden="true" />
		{pageLinks.map((link) => (
			<a
				class={`block px-3 py-2.5 rounded-lg hover:bg-ember/10 hover:text-ember dark:hover:text-ember-hot transition${isPageActive(link.url) ? ' text-ember' : ''}`}
				href={link.url}
			>
				{link.title}
			</a>
		))}
		<a
			href={CAL_URL}
			target="_blank"
			rel="noopener"
			class="block mt-1 px-3 py-2.5 rounded-lg text-center font-semibold text-white bg-ember hover:brightness-110 transition"
		>
			{t('nav.cta')}
		</a>
	</div>
</header>

<script>
	const PRODUCT_SECTIONS = ['video', 'problem', 'why', 'how', 'numbers', 'hood', 'get'];

	// --- Scroll-spy determinista por POSICIÓN de scroll (no IntersectionObserver).
	// El observer marcaba «la última entry del batch», que depende de la dirección
	// del scroll: bajando desde arriba dejaba marcada la sección siguiente (p. ej.
	// «why» estando en «problem»/«The wrong assumption»). La sección actual es, sin
	// ambigüedad, la última cuyo borde superior ya cruzó la línea de lectura (bajo el
	// header fijo). Mismo criterio que el LanguagePicker, para que ambos coincidan.
	//
	// Vive a nivel de módulo y consulta el DOM en cada pasada: el <script> se ejecuta
	// UNA vez por sesión (Astro no lo re-ejecuta en las view transitions), así que los
	// listeners de window se registran una sola vez y nunca se acumulan; runSpy() se
	// vuelve a llamar en cada astro:page-load (dentro de initHeader) para el DOM nuevo.
	const runSpy = () => {
		const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
		const probe = window.scrollY + 140; // línea de lectura, bajo el header fijo
		let id = '';
		for (const s of sections) if (s.offsetTop <= probe) id = s.id;
		// Al tocar fondo, la última sección aunque su borde no llegue a la línea.
		if (sections.length && window.innerHeight + window.scrollY >= document.body.scrollHeight - 4) {
			id = sections[sections.length - 1].id;
		}
		document.documentElement.dataset.section = id;
		// Marca la sección actual en la barra (desktop) Y en el desplegable móvil, por
		// el ANCLA del href (#sección) — así el móvil, que no lleva aria-label, se marca
		// igual que el desktop. Los enlaces a páginas aparte (Demos, Blog) y el CTA no
		// llevan ancla → no se tocan y conservan su marcado por ruta del servidor.
		document.querySelectorAll('#header-nav a, #mobile-menu a').forEach((item) => {
			const href = item.getAttribute('href') ?? '';
			const hash = href.indexOf('#');
			if (hash === -1) return;
			item.classList.toggle('text-ember', href.slice(hash + 1) === id);
		});
		document.getElementById('product-btn')?.classList.toggle('text-ember', PRODUCT_SECTIONS.includes(id));
	};

	// rAF-throttle: como mucho una pasada por frame (evita layout thrashing al leer
	// offsetTop en cada evento de scroll).
	let spyScheduled = false;
	const requestSpy = () => {
		if (spyScheduled) return;
		spyScheduled = true;
		requestAnimationFrame(() => {
			spyScheduled = false;
			runSpy();
		});
	};
	window.addEventListener('scroll', requestSpy, { passive: true });
	window.addEventListener('resize', requestSpy, { passive: true });

	const initHeader = () => {
		const menuBtn = document.getElementById('menu-btn');
		if (!menuBtn || menuBtn.dataset.bound === '1') return; // guard: no re-inicializar el mismo DOM
		menuBtn.dataset.bound = '1';

		// --- Scroll-spy: recalcula la sección actual para el DOM de esta página
		// (la lógica vive a nivel de módulo, ver runSpy arriba). productBtn se declara
		// aquí porque además lo usa el desplegable Product de más abajo.
		const productBtn = document.getElementById('product-btn');
		runSpy();

		// --- Menú móvil ---
		const menu = document.getElementById('mobile-menu');
		const setMobile = (open: boolean) => {
			menu?.classList.toggle('hidden', !open);
			menu?.classList.toggle('flex', open);
			menuBtn.setAttribute('aria-expanded', String(open));
		};

		// --- Desplegable Product (desktop) ---
		const productMenu = document.getElementById('product-menu');
		const setProduct = (open: boolean) => {
			productMenu?.classList.toggle('hidden', !open);
			productMenu?.classList.toggle('flex', open);
			productBtn?.setAttribute('aria-expanded', String(open));
		};

		menuBtn.addEventListener('click', (e) => {
			e.stopPropagation();
			document.getElementById('themes-menu')?.classList.remove('open'); // mutuamente excluyentes
			setProduct(false);
			setMobile(menu?.classList.contains('hidden') ?? false);
		});
		productBtn?.addEventListener('click', (e) => {
			e.stopPropagation();
			document.getElementById('themes-menu')?.classList.remove('open');
			setMobile(false);
			setProduct(productMenu?.classList.contains('hidden') ?? false);
		});

		// Cerrar al hacer clic en un enlace de cualquiera de los dos menús.
		menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMobile(false)));
		productMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setProduct(false)));

		// Clic fuera / Escape cierran ambos.
		document.addEventListener('click', () => {
			setMobile(false);
			setProduct(false);
		});
		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape') {
				setMobile(false);
				setProduct(false);
			}
		});
	};

	// Corre con view-transitions (astro:page-load) Y en carga directa (p. ej. 404,
	// donde astro:page-load puede no dispararse). El guard evita doble-init.
	document.addEventListener('astro:page-load', initHeader);
	if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initHeader);
	else initHeader();
</script>

---
import { getLangFromUrl, localePath, useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="problem" class="max-w-3xl mx-auto px-4 py-20 md:py-28">
	<SectionHeading eyebrow={t('problem.eyebrow')} title={t('problem.title')} />
	<p class="mt-6 text-lg af-muted">{t('problem.body')}</p>
	<p class="mt-4 text-lg">{t('problem.body2')}</p>
	<p class="mt-6">
		<a href={localePath(lang, '/deterministic-vs-ai/')} class="text-sm font-semibold text-ember dark:text-ember-hot hover:underline">{lang === 'es' ? 'Determinista vs IA, a fondo →' : 'Deterministic vs AI, in depth →'}</a>
	</p>
</section>

---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { WALKTHROUGH_URL } from '@/consts';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import VideoSlot from '@/components/ui/VideoSlot.astro';
const t = useTranslations(getLangFromUrl(Astro.url));

// La tarjeta "deep dive" es un enlace real solo cuando hay URL de walkthrough;
// mientras no la haya, se muestra como estado "próximamente" no-clicable (no un
// href muerto). El tag y los atributos se derivan de esa condición.
const hasWalkthrough = WALKTHROUGH_URL.length > 0;
const CardTag = hasWalkthrough ? 'a' : 'div';
const cardAttrs = hasWalkthrough
	? { href: WALKTHROUGH_URL, target: '_blank', rel: 'noopener' }
	: {};
---

<section id="video" class="max-w-4xl mx-auto px-4 py-16">
	<SectionHeading eyebrow={t('video.eyebrow')} title={t('video.title')} />
	<p class="mt-3 mb-8 af-muted">{t('video.sub')}</p>
	<VideoSlot label={t('video.soon')} />

	<!-- Vídeo 2 (deep dive): enlace real cuando hay WALKTHROUGH_URL; si no, estado "próximamente". -->
	<CardTag
		{...cardAttrs}
		class:list={[
			'af-card mt-4 p-4 flex items-center gap-4 transition',
			hasWalkthrough && 'hover:border-ember/40',
		]}
	>
		<div class="w-11 h-11 rounded-lg bg-ember/10 flex items-center justify-center flex-none">
			<svg class="w-5 h-5 fill-ember dark:fill-ember-hot ml-0.5" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"></path></svg>
		</div>
		<div class="flex-1 min-w-0">
			<div class="font-semibold text-sm">{t('video.watch')}</div>
			<div class="text-xs af-muted">{t('video.deepSub')}</div>
		</div>
		{hasWalkthrough ? (
			<span class="text-ember dark:text-ember-hot text-lg flex-none">→</span>
		) : (
			<span class="text-xs af-muted flex-none whitespace-nowrap">{t('demos.soon')}</span>
		)}
	</CardTag>
</section>


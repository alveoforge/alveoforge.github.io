---
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import SectionHeading from '@/components/ui/SectionHeading.astro';
const t = useTranslations(getLangFromUrl(Astro.url));
const roadmap = t('roadmap.items');
---

<section id="roadmap" class="max-w-4xl mx-auto px-4 py-20 md:py-28">
	<SectionHeading eyebrow={t('roadmap.eyebrow')} title={t('roadmap.title')} />
	<div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-4">
		{roadmap.map((r) => (
			<div class="af-card p-5">
				<h3 class="font-semibold">{r.t}</h3>
				<p class="mt-2 text-sm af-muted">{r.d}</p>
			</div>
		))}
	</div>
	<p class="mt-6 text-sm font-mono af-muted">{t('roadmap.note')}</p>
</section>
